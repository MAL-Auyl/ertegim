# Общие настройки обучения голоса. Подключается всеми скриптами (source).
# Любое значение можно переопределить переменной окружения:
#   SPEAKER=F2 MAX_HOURS=20 ./03_train.sh

# Рабочая папка для датасета, кэша и чекпоинтов. Держим её внутри WSL (ext4):
# на /mnt/c обучение в разы медленнее из-за файловой системы.
: "${WORK:=$HOME/ertegim-voice}"

# Диктор KazakhTTS2: F1, F2, F3 (женские), M1, M2 (мужские).
# F1 — ближе всего к нынешнему голосу героя (Raya, speaker 3 в kk_KZ-issai-high).
: "${SPEAKER:=F1}"

# Подъём тона, «вшиваемый» в обучающие записи. Совпадает с PITCH в
# tools/prerender.py, чтобы новый голос звучал как нынешний лисёнок — но без ffmpeg.
: "${PITCH:=1.4}"

# Сколько часов записи брать в обучение. Для дообучения 20–30 ч с запасом.
: "${MAX_HOURS:=30}"

# 16 безопасно для 16 ГБ VRAM (RTX A4000). Если памяти хватает — 24 или 32.
: "${BATCH_SIZE:=16}"

# Сколько эпох дообучать поверх базового чекпоинта (~5–10 мин/эпоха на A4000).
: "${EXTRA_EPOCHS:=150}"

# Базовый чекпоинт из huggingface.co/datasets/rhasspy/piper-checkpoints.
# Казахского там нет; русская Irina (medium) — кириллица, женский голос.
: "${BASE_CKPT:=ru/ru_RU/irina/medium}"

: "${VOICE_NAME:=kk_KZ-ertegim-medium}"
: "${ESPEAK_VOICE:=kk}"

# Версия piper1-gpl, на которой проверялся интерфейс `python -m piper.train`.
: "${PIPER_REF:=v1.8.0}"

HF_KAZAKHTTS="https://huggingface.co/datasets/issai/KazakhTTS/resolve/main"
HF_CKPTS="https://huggingface.co/datasets/rhasspy/piper-checkpoints/resolve/main"

PIPER_SRC="$WORK/piper1-gpl"
VENV="$WORK/venv"
RAW_DIR="$WORK/raw"
DATA_DIR="$WORK/data/$SPEAKER"
TRAIN_DIR="$WORK/train/$SPEAKER"
