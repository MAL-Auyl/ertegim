# Groq API key — STT (whisper-large-v3-turbo) + answer classifier. Required for voice.
GROQ_API_KEY=
# Local server port
PORT=3000
# Native helpers for the local server (all optional; resolved env → PATH → tools/.venv).
# See README «Переменные окружения».
FFMPEG_BIN=
WHISPER_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_VOICE_KK=
