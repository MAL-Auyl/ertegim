# Groq API key — STT (whisper-large-v3-turbo) + answer classifier. Required for voice.
GROQ_API_KEY=
# Optional: any OpenAI-compatible STT endpoint instead of Groq, e.g. the local
# Kazakh Whisper server (tools/stt/server.py, needs an NVIDIA GPU):
# STT_BASE_URL=http://127.0.0.1:3910/v1
STT_BASE_URL=
# Local server port
PORT=3000
# Native helpers for the local server (all optional; resolved env → PATH → tools/.venv).
# See README «Переменные окружения».
FFMPEG_BIN=
WHISPER_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_VOICE_KK=
